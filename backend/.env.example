# Copy to .env and fill in. Never commit the real .env.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Owner auth
OWNER_PASSWORD=change-me

# Repository backend: "memory" (no external DB, good for local dev) or "firebase"
REPO_BACKEND=memory
FIREBASE_CREDENTIALS=

# Groq (Task Valuer / Reward Classifier AI)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Generated receptacle content providers
DEVIANTART_CLIENT_ID=
DEVIANTART_CLIENT_SECRET=
JAMENDO_CLIENT_ID=

# Day-boundary for streaks / daily discard
TIMEZONE=UTC

# Frontend origin(s) allowed to call the API, comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

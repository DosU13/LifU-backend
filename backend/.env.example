# Copy to .env and fill in. Never commit the real .env.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Owner auth
OWNER_PASSWORD=change-me

# Repository backend: "memory" (no external DB, good for local dev) or "firebase"
REPO_BACKEND=memory
FIREBASE_CREDENTIALS=

# Groq (Task Valuer / Reward Classifier AI)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Generated receptacle content providers — ALL OPTIONAL.
# Live content already works without any of these: quotes/facts come from
# ZenQuotes and UselessFacts, art from the Art Institute of Chicago, music
# from the iTunes Search API — none of which need a key. Filling these in
# just adds DeviantArt and Jamendo to the pool for more variety.
# DeviantArt: https://www.deviantart.com/developers/  (needs BOTH id+secret)
DEVIANTART_CLIENT_ID=
DEVIANTART_CLIENT_SECRET=
# Jamendo: https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=

# Day-boundary for streaks / daily discard — must be a real IANA zone name
# (e.g. "Asia/Almaty", "Europe/Berlin"), NOT a fixed offset like "UTC+6"
TIMEZONE=UTC

# Frontend origin(s) allowed to call the API, comma-separated. Needed only
# when the frontend is served from a different origin than the API — in local
# development Vite proxies /api, so same-origin applies and this is unused.
# In production: CORS_ALLOWED_ORIGINS=https://lifu.doslan.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base for shareable friend trial links: <base>/<friend_name>
FRIEND_LINK_BASE_URL=https://lifu.doslan.com
